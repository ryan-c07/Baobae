# Must match the OAuth client used on the client (same string as VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
PORT=3847
ADMIN_TOKEN=replace_with_long_random_string

# Optional Google Sheets integration:
# Share your target spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_TAB_NAME=Votes
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep newlines escaped as \n when pasted into .env
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
